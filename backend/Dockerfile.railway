# Production image for Railway (the plain Dockerfile is for local development).
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=config.settings.railway

WORKDIR /app

COPY requirements/ /app/requirements/
RUN pip install --upgrade pip && pip install --no-cache-dir -r requirements/production.txt

COPY . /app/
RUN DJANGO_SECRET_KEY=build-only python manage.py collectstatic --noinput

RUN groupadd -r django && useradd -r -g django django && chown -R django:django /app
USER django

# Railway passes the port in $PORT. Migrations run first, then bots are pointed at this server's webhook.
# Every 5 minutes, in the background: lapsed Telegram requests expire, guests get their reminders
# (arrival / check-out / review, each sent once) and a lost webhook is restored. No Celery / cron service needed.
CMD ["sh", "-c", "python manage.py migrate --noinput && python manage.py createcachetable && python manage.py set_telegram_webhooks && { (while true; do sleep 300; python manage.py expire_telegram_requests || true; done) & exec gunicorn config.wsgi:application --bind 0.0.0.0:${PORT:-8000} --workers 2 --timeout 60 --access-logfile -; }"]
