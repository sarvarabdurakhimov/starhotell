# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# Database
DATABASE_URL=postgres://hms_user:hms_password@db:5432/hms_db

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_COOKIE_SECURE=False

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@hms.example.com

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Frontend
FRONTEND_URL=http://localhost:3000
# Telegram Mini App address (https only; defaults to FRONTEND_URL). The bot shows its "open app"
# and menu buttons only when this is https, e.g. https://starhotel.vercel.app
TELEGRAM_WEBAPP_URL=

# Sentry (production)
SENTRY_DSN=

# Owner's Claude assistant on Telegram (python manage.py run_assistant_bot)
# A separate bot from @BotFather (not a hotel's guest bot)
ASSISTANT_BOT_TOKEN=
# From https://platform.claude.com (API keys)
ANTHROPIC_API_KEY=
# Telegram ids allowed to use it, comma separated (send /id to the bot to see yours)
ASSISTANT_ALLOWED_CHAT_IDS=
